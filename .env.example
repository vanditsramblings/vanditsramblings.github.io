# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running production
# ─────────────────────────────────────────────────────────────────────────────

# ── Ghost ────────────────────────────────────────────────────────────────────
# Must match the public hostname configured in your Cloudflare tunnel
GHOST_URL=https://blog.yourdomain.com

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=ghost
MYSQL_PASSWORD=change_me_ghost_password
MYSQL_DATABASE=ghost

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Obtain from: Zero Trust > Networks > Tunnels > your tunnel > Configure > Token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── Mail (optional — for password resets and notifications) ──────────────────
# Set MAIL_TRANSPORT=Direct to use Ghost's built-in mailer with no SMTP config.
# For production use a transactional provider (e.g. SendGrid, Mailgun).
MAIL_TRANSPORT=SMTP
MAIL_FROM=noreply@yourdomain.com
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=your_sendgrid_api_key_here

# ── Ghost Admin API ──────────────────────────────────────────────────────────
# Populate AFTER first boot:
#   Ghost Admin > Settings > Integrations > Add custom integration > copy key
# Format: {key_id}:{hex_secret}
GHOST_ADMIN_API_KEY=your_key_id:your_hex_secret

# ── Backup (scripts/backup.sh) ───────────────────────────────────────────────
# SSH URL of the private Git repository used to store exported backups
BACKUP_REPO_URL=git@github.com:yourusername/ghost-backups-private.git

# Ghost URL reachable from the machine running backup.sh
GHOST_ADMIN_URL=http://localhost:2368

# Docker volume name that holds Ghost content (images, themes, files)
GHOST_CONTENT_VOLUME=ghost_content
