<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{asset 'css/screen.css'}}">
  {{ghost_head}}
</head>
<body class="{{body_class}}">
  <div class="shell">
    {{> "site-nav"}}
    <main class="main">
      {{{body}}}
    </main>
    {{> "site-footer"}}
  </div>

  <script>
    const root = document.documentElement;
    const toggle = document.querySelector('[data-theme-toggle]');

    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      localStorage.setItem('si-theme', theme);
    };

    const saved = localStorage.getItem('si-theme');
    const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    applyTheme(saved || preferred);

    toggle?.addEventListener('click', () => {
      applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
    });
  </script>

  {{ghost_foot}}
</body>
</html>